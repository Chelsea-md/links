{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "see-links",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Dashboard (built by Vite into ./dist/admin) is served by the Worker under /admin.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "see-links",
      // Replace with the id printed by `npx wrangler d1 create see-links`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Comma-separated short-link domains you own. The first one is the default.
    // Each must also be attached to this Worker as a Custom Domain (see "routes" below).
    "DOMAINS": "go.example.com",
    // Timezone used to bucket clicks into days on charts.
    "TZ": "Asia/Seoul",
    // Where to send visitors who open the bare domain (empty = the dashboard).
    "ROOT_REDIRECT": ""
  },

  // Uncomment and edit once your domain is on Cloudflare:
  // "routes": [
  //   { "pattern": "go.example.com", "custom_domain": true }
  // ],

  "observability": { "enabled": true }

  // Secrets (set with `npx wrangler secret put NAME`, or .dev.vars locally):
  //   ADMIN_PASSWORD  – password for the dashboard
  //   SESSION_SECRET  – random string used to sign login cookies and hash visitor ids
}
