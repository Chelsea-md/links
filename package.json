{
  "name": "see-links",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "See Links — personal short links + QR codes + analytics on your own domain (Cloudflare Workers + D1).",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply see-links --local",
    "db:migrate:remote": "wrangler d1 migrations apply see-links --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
